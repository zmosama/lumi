generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Row-Level Multi-tenancy Models

enum OrgType {
  SCHOOL
  CENTER
  PRIVATE_TUTOR
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  subdomain String   @unique
  orgType   OrgType  @default(SCHOOL) @map("org_type")
  plan      String   @default("trial")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  users       User[]
  branches    Branch[]
  students    Student[]
  teachers    Teacher[]
  classes     Class[]
  attendances Attendance[]
  payments    Payment[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  email        String
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("admin")
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([email, tenantId])
  @@map("users")
}

// Branch = فرع للمدرسة/السنتر، أو مجموعة/منطقة للمدرس الخصوصي
model Branch {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  area        String?
  isMain      Boolean  @default(false) @map("is_main")
  curriculums String[] // للمدارس: [ARABIC, LANGUAGES, IG] — ممكن أكتر من نوع
  ownership   String? // للمدارس: PRIVATE | GOVERNMENT
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  students Student[]
  teachers Teacher[]
  classes  Class[]

  @@map("branches")
}

enum PlatformRole {
  OWNER
  SALES
}

model PlatformUser {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String       @map("password_hash")
  name         String
  role         PlatformRole @default(SALES)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("platform_users")
}

model Student {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String   @map("branch_id")
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  parentName  String?  @map("parent_name")
  parentPhone String?  @map("parent_phone")
  grade       String?
  className   String?  @map("class_name")
  status      String   @default("active")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  attendances Attendance[]
  payments    Payment[]

  @@index([tenantId])
  @@index([branchId])
  @@index([status])
  @@map("students")
}

model Teacher {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?  @map("branch_id")
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  phone     String?
  subject   String?
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  classes Class[]

  @@index([tenantId])
  @@map("teachers")
}

model Class {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?  @map("branch_id")
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name      String
  grade     String?
  teacherId String?  @map("teacher_id")
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  capacity  Int      @default(30)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("classes")
}

model Attendance {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  status    String   @default("present")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([studentId, date])
  @@index([tenantId])
  @@map("attendance")
}

model Payment {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId   String    @map("student_id")
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Decimal   @db.Decimal(10, 2)
  description String?
  status      String    @default("paid")
  paidAt      DateTime? @map("paid_at") @db.Timestamptz
  dueDate     DateTime? @map("due_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("payments")
}
